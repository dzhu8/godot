#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

import os
import sys

env_python = env_modules.Clone()

# Detect Python installation
# Try to find Python using python-config or pkg-config
python_found = False
python_home_path = None

# For Windows, we'll try to use the Python that's running SCons
if env["platform"] == "windows":
    python_prefix = sys.prefix
    python_version = f"{sys.version_info.major}{sys.version_info.minor}"
    python_include = os.path.join(python_prefix, "include")
    python_lib_dir = os.path.join(python_prefix, "libs")
    python_lib = f"python{python_version}"

    print(f"Python Module: Checking for library at {python_lib_dir}")
    if os.path.exists(python_include) and os.path.exists(python_lib_dir):
        print(f"Python Module: Found Python {python_version} headers and libs.")
        print(f"  - Include: {python_include}")
        print(f"  - Lib: {python_lib_dir}")

        # Add headers to local env for compiling this module's C++ files
        env_python.Append(CPPPATH=[python_include])

        # CRITICAL: Add libs to the main 'env' so the final executable linker can find them
        env.Append(LIBPATH=[python_lib_dir])
        # Use explicit File object with full path to prevent SCons from adding Godot build suffixes
        # (like .windows.editor.x86_64.lib) to the external library name
        lib_path = os.path.join(python_lib_dir, python_lib + ".lib")
        env.Append(LIBS=[File(lib_path)])

        python_found = True
        python_home_path = python_prefix.replace("\\", "\\\\")  # Escape backslashes for C++
    else:
        print(f"Python Module: check failed. Inc: {os.path.exists(python_include)}, Lib: {os.path.exists(python_lib_dir)}")
else:
    # For Unix-like systems, try pkg-config
    import subprocess
    try:
        cflags = subprocess.check_output(["python3-config", "--cflags"]).decode().strip().split()
        ldflags = subprocess.check_output(["python3-config", "--ldflags", "--embed"]).decode().strip().split()
        env_python.Append(CCFLAGS=cflags)
        env_python.Append(LINKFLAGS=ldflags)
        python_found = True

        # Get Python prefix for Unix systems
        try:
            python_home_path = subprocess.check_output(["python3", "-c", "import sys; print(sys.prefix)"]).decode().strip()
        except:
            pass
    except:
        pass

if not python_found:
    print("Warning: Python development files not found. Python module may not compile.")

# Generate python_config.gen.h with embedded Python home path
config_header = "python_config.gen.h"
with open(config_header, "w") as f:
    f.write("// Auto-generated by SCsub - Do not edit\n")
    f.write("#ifndef PYTHON_CONFIG_GEN_H\n")
    f.write("#define PYTHON_CONFIG_GEN_H\n\n")
    if python_home_path:
        f.write(f'#define PYTHON_HOME_PATH "{python_home_path}"\n')
    else:
        f.write('#define PYTHON_HOME_PATH ""\n')
    f.write("\n#endif // PYTHON_CONFIG_GEN_H\n")

print(f"Python Module: Generated {config_header} with PYTHON_HOME_PATH = {python_home_path}")

# Add source files
env_python.add_source_files(env.modules_sources, "*.cpp")

# Ensure doc_classes directory exists
import os
# SCons changes current working directory to the SConscript file's directory.
doc_dir = "doc_classes"
if not os.path.exists(doc_dir):
    try:
        os.makedirs(doc_dir)
    except Exception:
        pass
